{
  "schemaVersion": 1,
  "id": "zomboidcraft",
  "version": "${version}",
  "name": "Endless Night",
  "description": "Halo Spartans and Tarkov operators purge a county overrun by Covenant-led Zomboid hordes.",
  "authors": ["Josiah Longfield"],
  "license": "MIT",
  "icon": "assets/zomboidcraft/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": ["com.zomboidcraft.ZomboidCraft"],
    "client": ["com.zomboidcraft.client.ZomboidCraftClient"],
    "voicechat": ["com.zomboidcraft.voice.RadioVoice"]
  },
  "mixins": [
    "zomboidcraft.mixins.json",
    {"config": "zomboidcraft.client.mixins.json", "environment": "client"}
  ],
  "depends": {
    "fabricloader": ">=0.17.0",
    "minecraft": "~${minecraft_version}",
    "java": ">=25",
    "fabric-api": "*"
  },
  "suggests": {
    "voicechat": "*"
  }
}
