{
 "multipart": [
  {
   "when": {
    "wet": "false"
   },
   "apply": {
    "model": "zomboidcraft:block/building/planter_box_dry"
   }
  },
  {
   "when": {
    "wet": "true"
   },
   "apply": {
    "model": "zomboidcraft:block/building/planter_box_wet"
   }
  },
  {
   "when": {
    "crop": "carrot",
