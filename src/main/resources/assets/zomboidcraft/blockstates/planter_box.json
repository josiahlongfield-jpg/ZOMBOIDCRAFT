    "age": "2|3"
   },
   "apply": {
    "model": "zomboidcraft:block/building/planter_carrot_1"
   }
  },
  {
   "when": {
    "crop": "carrot",
    "age": "4|5|6"
   },
   "apply": {
    "model": "zomboidcraft:block/building/planter_carrot_2"
   }
  },
  {
   "when": {
    "crop": "carrot",
    "age": "7"
